# Database connection strings
# For local Docker development: postgresql://postgres:postgres@localhost:5432/split
# For Neon / Vercel Postgres: use connection strings from your database dashboard
POSTGRES_PRISMA_URL="postgresql://postgres:postgres@localhost:5432/split"
POSTGRES_URL_NON_POOLING="postgresql://postgres:postgres@localhost:5432/split"
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/split"
DIRECT_URL="postgresql://postgres:postgres@localhost:5432/split"

# Admin Authentication
# Generate a secret: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
AUTH_SECRET="your-32-byte-base64-secret"
ADMIN_EMAIL="admin@futurechampsdigitalacademy.com"
ADMIN_PASSWORD="change_this_password_123!"

# Storage (Optional)
# Leave blank for local file uploads (saved to public/uploads/)
# For production on Vercel, set to your Vercel Blob read/write token
BLOB_READ_WRITE_TOKEN=""

